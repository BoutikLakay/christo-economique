rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrateurs : mettez ICI les adresses Gmail autorisées
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['princeofhati@gmail.com'];
    }

    // Carnets complets : administrateurs seulement
    match /clients/{id} {
      allow read, write: if isAdmin();
    }

    // Copie publique : lisible seulement si on connaît le document exact
    // (numéro + code). Pas de liste possible.
    match /public/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }
  }
}
